{
  "manifest_version": 3,
  "name": "Aio-DeepSeek",
  "version": "0.1.0",
  "description": "Aio-DeepSeek: Persian-first enhancement layer for DeepSeek - hidden prompts, tools, memory, file & presentation generation.",
  "permissions": [
    "storage",
    "contextMenus"
  ],
  "host_permissions": [
    "https://chat.deepseek.com/*",
    "https://codeload.github.com/*",
    "https://cdn.jsdelivr.net/*",
    "https://pyscript.net/*",
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://chat.deepseek.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "injected.js",
        "sandbox.html",
        "sandbox.js",
        "static/loading/*.svg"
      ],
      "matches": [
        "https://chat.deepseek.com/*"
      ]
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "sandbox": {
    "pages": [
      "sandbox.html"
    ]
  },
  "action": {
    "default_title": "Aio-DeepSeek"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'",
    "sandbox": "sandbox allow-scripts allow-forms allow-popups; script-src 'self' 'unsafe-eval' 'unsafe-inline' blob:; object-src 'self'"
  }
}